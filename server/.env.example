# Example environment variables for the server
# Option A: single DATABASE_URL (recommended when connecting to remote Postgres)
# Replace user, password, host, port and dbname accordingly.
DATABASE_URL=postgres://user:password@db-host.example.com:5432/sign

# Option B: individual DB connection values (used when DATABASE_URL is not set)
#DB_USER=postgres
#DB_PASSWORD=secret
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=sign

# Server settings
PORT=3002

# JWT secret used for authentication token signing (change in production)
JWT_SECRET=change_me_to_a_long_random_string
# Example environment variables for server
JWT_SECRET=your_jwt_secret_here

# Either use DATABASE_URL for Render / hosted Postgres
# DATABASE_URL=postgres://user:password@host:5432/database

# Or use separate Postgres settings for local development
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sign
